<Window x:Class="CafeOrderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CafeOrderApp.Models"
        xmlns:converters="clr-namespace:CafeOrderApp.Converters"
        xml:lang="ru-RU" Title="Заказ в кафе — вариант 10"
        Width="660" Height="370" MinWidth="560" MinHeight="350"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:ServicePercentConverter x:Key="PercentConverter"/>
        <converters:ServiceFontWeightConverter x:Key="FontWeightConverter"/>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <models:CafeOrder/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <TextBlock Text="Редактирование заказа" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>

            <TextBlock Text="Название блюда"/>
            <TextBox Text="{Binding DishName, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Цена за порцию, ₽"/>
            <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Количество порций"/>
            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Обслуживание, %"/>
            <TextBox Text="{Binding ServicePercent, Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged,
                                    Converter={StaticResource PercentConverter}}"/>
        </StackPanel>

        <Border Grid.Column="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="Карточка заказа" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <TextBlock Text="{Binding DishName, StringFormat='Блюдо — {0}'}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding UnitPrice, StringFormat='Цена за порцию — {0:C2}'}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding Quantity, StringFormat='Количество — {0}'}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding ServicePercent, StringFormat='Обслуживание — {0:P2}'}" Margin="0,8,0,0"/>
                <Separator Margin="0,12"/>
                <TextBlock Text="{Binding TotalPrice, StringFormat='Итого — {0:C2}'}" FontSize="17"
                           FontWeight="{Binding ServicePercent, Mode=OneWay,
                                                Converter={StaticResource FontWeightConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
